# Maintainer: Zalux Contributors <https://github.com/todo-laterx/zalux>
pkgname=zalux-bin
pkgver=26.10.20
pkgrel=1
pkgdesc='Unofficial Zalo desktop for Linux (native Rust call engine & N-API modules)'
arch=('x86_64')
url='https://github.com/todo-laterx/zalux'
license=('MIT')
depends=('opus' 'libpulse' 'libpipewire' 'xdg-desktop-portal' 'ffmpeg' 'gtk3' 'nss' 'libx11' 'libxcb' 'mesa' 'alsa-lib' 'libsecret' 'xdg-utils')
provides=('zalux')
conflicts=('zalux')
options=('!strip')
source=("zalux-bin-$pkgver.AppImage::https://github.com/todo-laterx/zalux/releases/download/${pkgver}/Zalux-${pkgver}-x86_64.AppImage"
        "zalux::git+https://github.com/todo-laterx/zalux.git")
sha256sums=('SKIP'
            'SKIP')

package() {
  cd "$srcdir"
  chmod +x "./zalux-bin-$pkgver.AppImage"
  "./zalux-bin-$pkgver.AppImage" --appimage-extract >/dev/null
  install -d "$pkgdir/opt/zalux"
  cp -a squashfs-root/. "$pkgdir/opt/zalux/"
  rm -rf "$pkgdir/opt/zalux/squashfs-root"

  install -Dm644 "$srcdir/zalux/assets/zalux.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/zalux.png"
  install -Dm644 "$srcdir/zalux/NOTICE" "$pkgdir/usr/share/doc/zalux/NOTICE"
  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/zalux.desktop" <<'DESK'
[Desktop Entry]
Name=Zalux
Comment=Zalux - Zalo Desktop for Linux
Exec=/usr/bin/zalux %U
Icon=zalux
Terminal=false
Type=Application
StartupWMClass=Zalo
Categories=Network;InstantMessaging;Chat;
MimeType=x-scheme-handler/zalo;
DESK
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/zalux" <<'WRAP'
#!/bin/sh
if [ -z "${GTK_THEME:-}" ] && command -v gsettings >/dev/null 2>&1; then
  case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || true)" in
    *dark*)
      _theme="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'" || true)"
      [ -n "$_theme" ] && export GTK_THEME="$_theme"
      ;;
  esac
fi
if [ -n "${DISPLAY:-}" ] && [ "${ZALUX_WAYLAND_NATIVE:-0}" != "1" ]; then
  set -- --ozone-platform=x11 --enable-features=JXL,WebRTCPipeWireCapturer "$@"
else
  set -- --ozone-platform=wayland --enable-features=JXL,WaylandWindowDecorations,WebRTCPipeWireCapturer "$@"
fi
exec /usr/bin/env -u ELECTRON_RUN_AS_NODE -u GIO_LAUNCHED_DESKTOP_FILE -u GIO_LAUNCHED_DESKTOP_FILE_PID -u SNAP -u SNAP_NAME -u SNAP_APP_DESKTOP_FILE CHROME_DESKTOP=zalux.desktop BAMF_DESKTOP_FILE_HINT=/usr/share/applications/zalux.desktop /opt/zalux/zalo --no-sandbox --disable-crash-reporter --disable-gpu-memory-buffer-video-frames "$@"
WRAP
  chmod 755 "$pkgdir/usr/bin/zalux"
}
